<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ros_slam_robot">
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.225"/>

  <material name="body_blue"><color rgba="0.05 0.18 0.55 1"/></material>
  <material name="wheel_white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="lidar_black"><color rgba="0.03 0.03 0.03 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.28 0.25 0.07"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.28 0.25 0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.035"/>
      <inertia ixx="0.014" ixy="0" ixz="0" iyy="0.018" iyz="0" izz="0.027"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_white"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00013"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.018"/></geometry>
      <material name="wheel_white"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.105 0 -0.047"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.052" length="0.038"/></geometry>
      <material name="lidar_black"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.045 0 0.145"/>
  </joint>
</robot>
